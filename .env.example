APP_NAME=Agricart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://agricart.test

# --- Live / staging host (copy to server .env) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agricart
DB_USERNAME=root
DB_PASSWORD=

# Quick tests only (phpunit uses sqlite in-memory). Do NOT restore hosting .zip backups on sqlite.
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# After restore: keep local-only staff/customer logins (merge by email). Default true.
# BACKUP_PRESERVE_LOCAL_LOGINS=true
# Local/dev only — leave EMPTY on production Hostinger:
# BACKUP_BOOTSTRAP_ADMIN_EMAIL=admin@agricart.test
# BACKUP_BOOTSTRAP_ADMIN_PASSWORD=password
# BACKUP_BOOTSTRAP_ADMIN_FORCE_LOCAL=true

# Backup limits (app-side). Browser upload still limited by PHP upload_max_filesize / post_max_size.
# For multi-GB zips use Settings → Backups → incoming folder (FTP / File Manager).
# BACKUP_MAX_FILE_BYTES=6442450944
# BACKUP_MAX_TOTAL_BYTES=107374182400
# BACKUP_RETENTION_COUNT=10

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true on HTTPS hosts (auto-true when APP_URL uses https if omitted):
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# auto = serve /storage via Laravel when symlink missing (Hostinger). false = VPS + storage:link only.
FILESYSTEM_PUBLIC_SERVE=auto
# Future: s3 after composer require league/flysystem-aws-s3-v3
FILESYSTEM_MEDIA_DISK=public

# Hostinger fixed public_html (optional — not used on VPS with docroot = public/)
# HOSTINGER_PUBLIC_HTML=/home/USERNAME/domains/example.com/public_html
# HOSTINGER_APP_FOLDER_NAMES=agricart,Agricart

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
