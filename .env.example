APP_NAME=Agricart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://agricart.test
APP_RELEASE=

# --- Live / staging host (copy to server .env) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# APP_RELEASE=git-commit-or-deployment-id
# SESSION_SECURE_COOKIE=true
# Prefer explicit proxy CIDRs. Wildcard requires deliberate acknowledgement:
# TRUSTED_PROXIES=10.0.0.0/8
# ALLOW_WILDCARD_TRUSTED_PROXIES=false
# SCHEDULER_CONFIGURED=true
# QUEUE_WORKER_CONFIGURED=true
# SCHEDULER_SHARED_LOCKS=false
# HEALTHCHECK_URL=https://your-domain.com/up
# Required in production. Keep report-only until inline scripts have been nonce/hash migrated.
# SECURITY_CSP_MODE=report-only
# Deprecated — private docs migrate on authorized read. Leave false / unset.
# SECURITY_LEGACY_PUBLIC_PAYMENT_PROOF_FALLBACK=false
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_CHANNEL=daily, LOG_LEVEL=warning, LOG_DAILY_DAYS=14
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agricart
DB_USERNAME=root
DB_PASSWORD=

# Quick tests only (phpunit uses sqlite in-memory). Do NOT restore hosting .zip backups on sqlite.
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# After restore: keep local-only staff/customer logins (merge by email). Default true.
# BACKUP_PRESERVE_LOCAL_LOGINS=true
# Local/dev only — leave EMPTY on production Hostinger:
# BACKUP_BOOTSTRAP_ADMIN_EMAIL=admin@agricart.test
# BACKUP_BOOTSTRAP_ADMIN_PASSWORD=password
# BACKUP_BOOTSTRAP_ADMIN_FORCE_LOCAL=true

# Automatic backups (defaults; override anytime in Settings → Backups UI)
# Requires Hostinger cron: schedule:run every minute (not the backup clock time)
# BACKUP_SCHEDULE_ENABLED=true
# BACKUP_SCHEDULE_TYPE=full
# BACKUP_SCHEDULE_FREQUENCY=weekly
# BACKUP_SCHEDULE_TIME=02:00
# BACKUP_SCHEDULE_WEEKDAY=0
# BACKUP_DATABASE_DAILY_ENABLED=false
# BACKUP_DATABASE_DAILY_TIME=01:30

# Backup limits (app-side). Browser upload still limited by PHP upload_max_filesize / post_max_size.
# For multi-GB zips use Settings → Backups → incoming folder (FTP / File Manager).
# BACKUP_MAX_FILE_BYTES=6442450944
# BACKUP_MAX_TOTAL_BYTES=107374182400
# BACKUP_RETENTION_COUNT=14
# BACKUP_ARCHIVE_MAX_ENTRIES=100000
# BACKUP_ARCHIVE_MAX_ENTRY_BYTES=2147483648
# BACKUP_ARCHIVE_MAX_UNCOMPRESSED_BYTES=21474836480
# BACKUP_ARCHIVE_MAX_COMPRESSION_RATIO=200
# BACKUP_ARCHIVE_MAX_MANIFEST_BYTES=65536
# Production defaults to captured local logins replacing same-email archive logins.
# BACKUP_PRODUCTION_LOGIN_MODE=authoritative

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true on HTTPS hosts (auto-true when APP_URL uses https if omitted):
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# auto = serve /storage via Laravel when symlink missing (Hostinger). false = VPS + storage:link only.
FILESYSTEM_PUBLIC_SERVE=auto
# Future: s3 after composer require league/flysystem-aws-s3-v3
FILESYSTEM_MEDIA_DISK=public

# First-party visitor analytics (generate a separate random 64+ character key in production).
ANALYTICS_ENABLED=true
ANALYTICS_HASH_KEY=
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_VISITOR_RETENTION_DAYS=760
ANALYTICS_ROLLUP_RETENTION_DAYS=1095
STORE_INQUIRY_CLOSED_RETENTION_DAYS=730
STORE_INQUIRY_METADATA_RETENTION_DAYS=90
AI_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_RETENTION_DAYS=90
SYSTEM_ERROR_RETENTION_DAYS=90
MEDIA_TRASH_RETENTION_DAYS=30
# Free MaxMind account credentials for the monthly local GeoLite2 City update.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Hostinger fixed public_html (optional — not used on VPS with docroot = public/)
# HOSTINGER_PUBLIC_HTML=/home/USERNAME/domains/example.com/public_html
# HOSTINGER_APP_FOLDER_NAMES=agricart,Agricart
# HOSTINGER_STORAGE_MIRROR_EXCLUSIONS=private,livewire-tmp,users/cnic,online-orders/customer-receipts,online-orders/payment-proofs,online-orders/shipping-proofs

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
