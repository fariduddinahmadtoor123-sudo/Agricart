# Deny script execution under public uploads (Hostinger / Apache).
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<FilesMatch "(?i)\.(php|phtml|phar|php\d+|phps|cgi|pl|py|jsp|asp|aspx|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
